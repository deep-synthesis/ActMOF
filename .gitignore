# design_grid_part*.csv (~233MB total, each file well under GitHub's 50MB/
# 100MB thresholds) are shipped directly in data/ -- NOT ignored, so they are
# NOT regenerated by whoever clones this repo. dataset_construction/ is kept
# only as the from-scratch, independently-verifiable alternative.
# Ignore anything else that lands in data/ (e.g. a local xlsx export).
data/*.xlsx
data/*.tmp

# Generated run outputs -- regenerate with benchmark/run_all_methods.py
outputs/*
!outputs/.gitkeep
!outputs/*/
outputs/*/*
!outputs/*/.gitkeep

# caches written by the analysis scripts
analyses/*/_oracle.npy
analyses/landscape_robustness/maps/

__pycache__/
*.pyc
.ipynb_checkpoints/
